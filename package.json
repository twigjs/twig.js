{
  "name": "twig",
  "version": "3.0.0",
  "description": "JS port of the Twig templating language.",
  "homepage": "https://github.com/twigjs/twig.js",
  "license": "BSD-2-Clause",
  "author": "John Roepke <john@justjohn.us> (http://john.sh/)",
  "repository": {
    "type": "git",
    "url": "git://github.com/twigjs/twig.js.git"
  },
  "bin": {
    "twigjs": "./bin/twigjs"
  },
  "main": "src/twig.js",
  "browser": {
    "fs": false
  },
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "preversion": "npm test && git diff --exit-code --quiet",
    "postversion": "git push origin master && git push origin master --tags",
    "pretest": "npm run build",
    "test": "mocha -r should",
    "build": "node node/build.js",
    "posttest": "npm run lint",
    "lint": "eslint",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "locutus": "^3.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.8.3",
    "@babel/preset-env": "^7.8.4",
    "@babel/runtime": "^7.8.4",
    "@eslint/js": "^9.39.3",
    "babel-loader": "^10.0.0",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "mocha": "12.0.0-beta-10",
    "oxfmt": "^0.74.0",
    "path-browserify": "^1.0.1",
    "should": "^13.2.3",
    "should-sinon": "0.0.6",
    "sinon": "^21.0.0",
    "terser-webpack-plugin": "^5.3.6",
    "tokenizer2": "^2.0.1",
    "vitepress": "2.0.0-alpha.20",
    "webpack": "^5.75.0",
    "webpack-cli": "^6.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "licenses": [
    {
      "type": "BSD-2-Clause",
      "url": "https://raw.github.com/twigjs/twig.js/master/LICENSE"
    }
  ]
}
